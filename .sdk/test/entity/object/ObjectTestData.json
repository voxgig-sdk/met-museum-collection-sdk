                      "type": "string"
                    },
                    "subregion": {
                      "description": "Geographic location more specific than Region",
                      "example": "Malqata",
                      "type": "string"
                    },
                    "tags": {
                      "description": "An array of subject keyword tags associated with the object",
                      "items": {
                        "properties": {
                          "AAT_URL": {
                            "type": "string"
                          },
                          "Wikidata_URL": {
                            "type": "string"
                          },
                          "term": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "title": {
                      "description": "Title, identifying phrase, or name given to a work of art",
