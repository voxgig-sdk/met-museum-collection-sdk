eEnd\",\"required\":false,\"schema\":{\"example\":1900,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"objectIDs\":{\"description\":\"An array containing the object IDs of matching objects\",\"items\":{\"type\":\"integer\"},\"nullable\":true,\"type\":\"array\"},\"total\":{\"description\":\"The total number of objects matching the search query\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Successful response\"},\"429\":{\"description\":\"Rate limit exceeded (80 requests per second)\"}},\"securitySource\":\"unspecified\"}"
