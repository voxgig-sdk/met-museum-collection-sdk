# Entity: department

main: kit: entity: department: {

  alias: field: {}

  fields: [
    {
      name: "departmentId"
      req: false
      short: "Unique identifier for the department"
      type: "`$INTEGER`"
    }
    {
      name: "displayName"
      req: false
      short: "Display name of the department"
      type: "`$STRING`"
    }
  ]

  name: "department"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/departments"
          segments: [
            {
              lit: "departments"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.departments`"
          }
        }
      ]
    }
  }



}
